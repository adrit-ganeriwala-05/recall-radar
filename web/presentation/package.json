{
  "name": "recall-radar-observatory",
  "private": true,
  "version": "0.1.0",
  "description": "Recall Radar presentation (The Automotive Observatory), static export served at /observatory. Owner: C.",
  "scripts": {
    "dev": "next dev --port 3100",
    "build": "next build",
    "typecheck": "next typegen && tsc --noEmit",
    "check": "node scripts/check-copy.mjs",
    "e2e": "playwright test --grep-invert @solo && playwright test --grep @solo --workers=1",
    "serve": "node scripts/serve-static.mjs",
    "release": "npm run check && npm run build && node scripts/release.mjs",
    "gen:contracts": "json2ts --unreachableDefinitions -i ../../contracts/schema/recall_radar.schema.json -o src/contracts.gen.ts"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "5.3.0",
    "@fontsource-variable/space-grotesk": "5.3.0",
    "@react-three/drei": "10.7.9",
    "@react-three/fiber": "9.8.1",
    "gsap": "3.15.0",
    "lenis": "1.3.26",
    "next": "16.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "three": "0.182.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.64.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.19.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.182.0",
    "json-schema-to-typescript": "16.0.0",
    "postcss": "8.5.29",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3"
  }
}
