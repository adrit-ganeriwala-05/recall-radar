# F9.6 scheduled monitor + digest flush (PRD_v2 §4 F9.6). Owner: D. Started only by its timer, and the timer only
# by `gatep.sh on` (stopped by `gatep.sh off`). The job itself is a no-op unless RR_MESSAGING_ENABLED=1.
# Outbound: api.nhtsa.gov (one fetch per watched vehicle per day) and the loopback Photon sidecar.
[Unit]
Description=Recall Radar messaging monitor (F9.6)
After=network-online.target recall-radar-sidecar.service

[Service]
Type=oneshot
User=rr
Group=rr
WorkingDirectory=/opt/recall-radar/current
Environment=RR_DATA_DIR=/opt/recall-radar/data
Environment=RR_PHOTON_SIDECAR_URL=http://127.0.0.1:8790
EnvironmentFile=/etc/recall-radar/messaging.env
ExecStart=/opt/recall-radar/current/.venv/bin/python -m recall_radar.messaging.job
TimeoutStartSec=300
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
# read-only, not true: the venv's interpreter is uv's, under /home/rr
ProtectHome=read-only
ReadWritePaths=/opt/recall-radar/data
