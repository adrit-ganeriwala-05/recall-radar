# /etc/recall-radar/messaging.env (root:rr 0640). Owner: D. Installed once by deploy/messaging/install.sh,
# never overwritten. Kill switch: RR_MESSAGING_ENABLED=0 (default) → every webhook request 503, nothing stored.
# Turn on ONLY during Gate P (PRD_v2 §8), for the opted-in tester, and set it back to 0 afterwards.
RR_MESSAGING_ENABLED=0
# Per-webhook signing secret from the Spectrum dashboard (Gate P). Empty = every signed request rejected.
IMESSAGE_WEBHOOK_SECRET=
