# Recall Radar reverse proxy. Owner: D.
# Installed to /etc/caddy/Caddyfile by deploy/vm_setup.sh and refreshed by deploy/deploy.sh.
# Site address = RR_SITE (systemd drop-in written by vm_setup.sh):
#   a domain name -> Caddy obtains and renews HTTPS certificates automatically (ports 80+443 open)
#   :80 (default, bare IP) -> plain HTTP
# Caddy serves the built web app itself and proxies only the API, so if uvicorn is down the UI
# still loads and its client falls back to the bundled /demo/*.json (C's review note on PR #3).
{$RR_SITE::80} {
	encode zstd gzip
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
		# index.html and SPA routes must not go stale after a redeploy; responses that already
		# set Cache-Control (the API sets max-age=3600, CONTRACTS.md section 6) keep their value.
		?Cache-Control "no-cache"
	}
	handle /api/* {
		reverse_proxy 127.0.0.1:8000
	}
	handle /healthz {
		reverse_proxy 127.0.0.1:8000
	}
	# F9 (Gate P): Photon Spectrum webhooks → messaging service. While messaging is disabled it answers 503
	# (and 502 if the unit is not installed); unsigned or stale requests are rejected by the service (401).
	handle /spectrum-webhook {
		reverse_proxy 127.0.0.1:8791
	}
	handle {
		root * /opt/recall-radar/current/web/dist
		try_files {path} /index.html
		file_server
	}
	log
}
