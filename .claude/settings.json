{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "autoMemoryEnabled": false,
  "permissions": {
    "allow": [
      "Bash(make *)",
      "Bash(uv run *)",
      "Bash(uv sync *)",
      "Bash(uv lock *)",
      "Bash(npm run *)",
      "Bash(npm ci *)",
      "Bash(npm --prefix web run *)",
      "Bash(npm --prefix web ci *)",
      "Bash(npx vitest *)",
      "Bash(npx tsc *)",
      "Bash(npx playwright test *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git branch *)",
      "Bash(git fetch *)",
      "Bash(git rev-parse *)",
      "Bash(git merge-base *)",
      "Bash(git cat-file *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git switch *)",
      "Bash(git merge origin/main *)",
      "Bash(git merge --abort *)",
      "Bash(gh pr view *)",
      "Bash(gh pr list *)",
      "Bash(gh pr checks *)",
      "Bash(gh pr create *)",
      "Bash(gh run list *)",
      "Bash(gh run view *)",
      "Bash(duckdb *)",
      "Bash(shasum *)",
      "Bash(sha256sum *)",
      "Bash(unzip *)",
      "Bash(curl -fsS http://127.0.0.1:*)",
      "Bash(curl -fsS http://localhost:*)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(git tag *)",
      "Bash(gh pr merge *)",
      "Bash(make deploy *)",
      "Bash(ssh *)",
      "Bash(scp *)",
      "Bash(rsync *)",
      "Bash(uv add *)",
      "Bash(uv remove *)",
      "Bash(npm install *)",
      "Bash(npm uninstall *)",
      "Bash(make deploy)",
      "Bash(make vm-setup*)",
      "Bash(make sync-data*)",
      "Bash(make rollback*)",
      "Bash(make outage-check*)",
      "Bash(bash deploy/*)"
    ],
    "deny": [
      "Agent",
      "Bash(git push *--force*)",
      "Bash(git push -f*)",
      "Bash(git push * -f*)",
      "Bash(git reset --hard*)",
      "Bash(git clean *)",
      "Bash(git rebase *)",
      "Bash(git filter-branch *)",
      "Bash(git branch -D *)",
      "Bash(git remote set-url *)",
      "Bash(git remote remove *)",
      "Bash(git remote rm *)",
      "Bash(gh repo create *)",
      "Bash(gh repo delete *)",
      "Bash(rm -rf *)",
      "Bash(sudo *)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./deploy/secrets/**)",
      "Read(~/.ssh/**)"
    ]
  }
}
