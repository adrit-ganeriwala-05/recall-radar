# Copy to .env (gitignored) and fill in. Never commit .env. Owner: D.
# Only RR_* variables are needed for P0. Secrets never go into web/ or any VITE_* variable.

# Where raw zips and DuckDB files live (outside git). Separate per checkout on one computer.
RR_DATA_DIR=data
# Optional: directory that already holds the downloaded NHTSA zips + SHA256SUMS.txt
RR_RAW_DIR=data/raw
# API server
RR_API_HOST=127.0.0.1
RR_API_PORT=8000
RR_MODE=cached            # cached | fixture
# Frontend dev server (C) and the API it proxies to
VITE_PORT=5173
VITE_API_BASE=/api

# Deployment (D's machine only)
RR_VM_HOST=<VM_IP_OR_DOMAIN>
RR_VM_USER=<VM_SSH_USER>
RR_PUBLIC_BASE_URL=https://<YOUR_DOMAIN_OR_IP>

# P1 only, batch machine only, never on the VM, never in the browser
GEMINI_API_KEY=
